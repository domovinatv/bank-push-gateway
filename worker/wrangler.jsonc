{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bank-push-gateway",
  "account_id": "7dc7167b7e2e00923bfa7cd697df14e4", // D.O.M.
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Jedan javni endpoint; workers.dev isključen.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "bank-push-gateway.domovina.ai", "custom_domain": true }
  ],
  "vars": {
    // Uređaji kojima je dopuštena autentikacija tokenom umjesto HMAC-a
    // (MacroDroid ne može potpisati tijelo zahtjeva). Zarezom odvojeno.
    "TOKEN_AUTH_DEVICES": "",
    // Admin: tko smije u /admin (i preko Accessa i passkeyem).
    "ADMIN_EMAILS": "stepanic.matija@gmail.com,ms@ff.hr",
    // Cloudflare Access aplikacija na bank-push-gateway.domovina.ai/admin/sso.
    // Prazno = ulaz preko Accessa isključen.
    "ACCESS_TEAM_DOMAIN": "domovina.cloudflareaccess.com",
    "ACCESS_AUD": "785015c8d0d4562a90727173185271600478ae862f12b5a8bb8da38266529264"
  },
  "durable_objects": {
    "bindings": [{ "name": "LIVE_FEED", "class_name": "LiveFeed" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveFeed"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bank_push_gateway",
      "database_id": "aae38cef-72fd-4f84-a2be-06253ddd12da",
      "migrations_dir": "migrations"
    }
  ]
  // DEVICE_SECRETS: `wrangler secret put DEVICE_SECRETS` (produkcija) ili
  // worker/.dev.vars (lokalno). JSON: {"gw-01": "<tajna>"}
}
