{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bank-push-gateway",
  "account_id": "7dc7167b7e2e00923bfa7cd697df14e4", // D.O.M.
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Jedan javni endpoint; workers.dev isključen.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "bank-push-gateway.domovina.ai", "custom_domain": true }
  ],
  "vars": {
    // Uređaji kojima je dopuštena autentikacija tokenom umjesto HMAC-a
    // (MacroDroid ne može potpisati tijelo zahtjeva). Zarezom odvojeno.
    "TOKEN_AUTH_DEVICES": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bank_push_gateway",
      "database_id": "aae38cef-72fd-4f84-a2be-06253ddd12da",
      "migrations_dir": "migrations"
    }
  ]
  // DEVICE_SECRETS: `wrangler secret put DEVICE_SECRETS` (produkcija) ili
  // worker/.dev.vars (lokalno). JSON: {"gw-01": "<tajna>"}
}
